{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market-first outreach pipeline config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "market_research",
    "workflow"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "market_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_json",
        "mcp"
      ],
      "properties": {
        "input_json": {
          "type": "string",
          "minLength": 1
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "mode": {
              "enum": [
                "live",
                "fixture"
              ],
              "default": "live"
            },
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "fixture_json": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "fixture"
                  }
                }
              },
              "then": {
                "required": [
                  "fixture_json"
                ]
              }
            }
          ]
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "series_id",
            "market",
            "selected_by"
          ],
          "properties": {
            "series_id": {
              "type": "string",
              "minLength": 1
            },
            "market": {
              "type": "string",
              "minLength": 1
            },
            "selected_by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "contract_version",
        "run_id",
        "start_mode",
        "lead_discovery",
        "customer_intel",
        "outreach"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "start_mode": {
          "const": "discovery"
        },
        "lead_discovery": {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "input"
                ]
              },
              {
                "required": [
                  "input_json"
                ]
              }
            ]
          }
        }
      },
      "description": "Existing combo workflow config; discovery input and market_context are generated by the market stage."
    }
  }
}
